# FreeLLMAPI unified key from the local dashboard (Keys page)
VITE_FREELLMAPI_KEY=freellmapi-your-unified-key

# Leave unset in dev to use Vite proxy → http://127.0.0.1:3001
# Or set a full base including /v1, e.g. http://127.0.0.1:3001/v1
# VITE_FREELLMAPI_BASE=http://127.0.0.1:3001/v1

# Image model id from https://freellmapi.co/models?type=image
# VITE_FREELLMAPI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
