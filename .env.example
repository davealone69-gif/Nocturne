# Server-side only (Vite proxy injects this — NOT prefixed with VITE_)
# Get the unified key from FreeLLMAPI dashboard → Keys
FREELLMAPI_KEY=freellmapi-your-unified-key

# Optional: FreeLLMAPI origin (default http://127.0.0.1:3001)
# FREELLMAPI_URL=http://127.0.0.1:3001

# Optional client overrides (safe to expose)
# VITE_FREELLMAPI_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
# VITE_FREELLMAPI_BASE=/freellm/v1
